# Automindlab Outreach
Options -Indexes
DirectoryIndex index.php

# Block direct access to internals
<FilesMatch "^(config\.php|outreach-config\.php|config\.sample\.php|.*\.md|.*\.sql|.*\.yml|LICENSE|\..*|.*\.log|.*\.lock|.*\.cache|heartbeat\.check|.*\.stamp)$">
  Require all denied
</FilesMatch>
# Repository folders (when deployed with Git): never served
RedirectMatch 404 (?i)/\.(git|github)(/|$)

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Force HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # Deny lib/, vendor/, storage/, docs/, dev/ and any dot-folder (.git, .github)
  RewriteRule ^(lib|vendor|storage|docs|dev)(/|$) - [F,L]
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
</IfModule>

<IfModule mod_headers.c>
  Header set X-Frame-Options "DENY"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "same-origin"
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>

# Speed: compress text responses, and let browsers keep versioned assets (app.css?v=…) for a year
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.php$">
    Header set Cache-Control "no-store"
  </FilesMatch>
</IfModule>
